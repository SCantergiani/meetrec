#!/usr/bin/env bash
# Record mic + system audio as separate tracks (press q to stop), transcribe, label speakers.
# usage: meetrec [MODEL] [NUM_REMOTE_SPEAKERS]   (e.g. meetrec "" 3)
set -euo pipefail
dir=${MEETREC_DIR:-$HOME/Recordings}
mkdir -p "$dir"
base=$dir/meeting-$(date +%F_%H%M)
echo "Recording to $base-{me,them}.ogg — press q to stop"
# separate tracks: no clipping from mixing, no echo duplicates, "Me" vs "Them" for free
ffmpeg -hide_banner -loglevel warning -stats \
    -f pulse -i default -f pulse -i "$(pactl get-default-sink).monitor" \
    -map 0:a -ac 1 -c:a libopus -b:a 48k "$base-me.ogg" \
    -map 1:a -ac 1 -c:a libopus -b:a 48k "$base-them.ogg"
transcribe "$base-me.ogg" ${1:+"$1"}
transcribe "$base-them.ogg" ${1:+"$1"}
# split "Them" into Them A/B/... by voice (local model)
diarize "$base-them.ogg" "$base-them.tsv" ${2:+"$2"}
meetmerge "$base"
