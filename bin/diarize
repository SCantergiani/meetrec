#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["sherpa-onnx", "numpy"]
# ///
"""Add a speaker column (A, B, ...) to a whisper .tsv by clustering voice embeddings. Fully local, CPU.

usage: diarize AUDIO TSV [NUM_SPEAKERS]   (rewrites TSV in place; NUM_SPEAKERS omitted = auto)
If the sibling .json has word timestamps, rows are split at the word where the speaker changes.
Models: pyannote segmentation 3.0 + 3D-Speaker ERes2Net (sherpa-onnx ONNX exports, ungated),
downloaded to ~/.cache/sherpa-onnx on first run.
"""
import json
import os
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path

import numpy as np
import sherpa_onnx

M = Path.home() / ".cache/sherpa-onnx"
R = "https://github.com/k2-fsa/sherpa-onnx/releases/download"
SEG = M / "sherpa-onnx-pyannote-segmentation-3-0/model.onnx"
EMB = M / "3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx"
# ponytail: auto-count threshold tuned on one 40-min 2-person call (1.0-1.1 over-split into 14-28,
# 1.3 -> 2). Fragile: on a 3-min clip 1.3 merged both speakers into one. Pass NUM_SPEAKERS when known.
THRESHOLD = 1.3

M.mkdir(parents=True, exist_ok=True)
if not SEG.exists():
    with urllib.request.urlopen(f"{R}/speaker-segmentation-models/sherpa-onnx-pyannote-segmentation-3-0.tar.bz2") as f:
        tarfile.open(fileobj=f, mode="r|bz2").extractall(M, filter="data")
if not EMB.exists():
    urllib.request.urlretrieve(f"{R}/speaker-recongition-models/{EMB.name}", EMB)

audio, tsv = sys.argv[1], Path(sys.argv[2])
num = int(sys.argv[3]) if len(sys.argv) > 3 else -1
threads = min(8, os.cpu_count() or 1)

emb_cfg = sherpa_onnx.SpeakerEmbeddingExtractorConfig(model=str(EMB), num_threads=threads)
# Forcing exactly `num` clusters is unstable on long files: a few seconds of noise can take a slot and
# two real voices get merged (same 55-min interview: 10% vs 99% "A" from near-identical decodes).
# So over-cluster, keep the `num` clusters with the most speech, fold the rest into the closest voice.
sd = sherpa_onnx.OfflineSpeakerDiarization(sherpa_onnx.OfflineSpeakerDiarizationConfig(
    segmentation=sherpa_onnx.OfflineSpeakerSegmentationModelConfig(
        pyannote=sherpa_onnx.OfflineSpeakerSegmentationPyannoteModelConfig(model=str(SEG)), num_threads=threads),
    embedding=emb_cfg,
    clustering=sherpa_onnx.FastClusteringConfig(num_clusters=num + 3 if num > 0 else -1, threshold=THRESHOLD),
    min_duration_on=0.3, min_duration_off=0.5,
))
sr = sd.sample_rate
pcm = np.frombuffer(subprocess.run(["ffmpeg", "-loglevel", "error", "-i", audio, "-ac", "1", "-ar", str(sr), "-f", "f32le", "-"],
                                   capture_output=True, check=True).stdout, np.float32)


def progress(done, total):
    print(f"\rDetecting speakers... {100 * done // total}%", end="", file=sys.stderr, flush=True)
    return 0


turns = [(t.start * 1000, t.end * 1000, t.speaker) for t in sd.process(pcm, callback=progress).sort_by_start_time()]
print(file=sys.stderr)

if num > 0:
    dur = {}
    for s, e, k in turns:
        dur[k] = dur.get(k, 0) + e - s
    big = sorted(dur, key=dur.get, reverse=True)[:num]
    ext = sherpa_onnx.SpeakerEmbeddingExtractor(emb_cfg)

    def voice(k):
        """Mean-direction embedding of up to 60 s of cluster k's speech."""
        audio_k = np.concatenate([pcm[int(s * sr / 1000):int(e * sr / 1000)] for s, e, c in turns if c == k])[:60 * sr]
        st = ext.create_stream()
        st.accept_waveform(sr, audio_k)
        st.input_finished()
        v = np.array(ext.compute(st))
        return v / np.linalg.norm(v)

    centroid = {k: voice(k) for k in dur}
    merge = {k: k if k in big else max(big, key=lambda b: centroid[k] @ centroid[b]) for k in dur}
    turns = [(s, e, merge[k]) for s, e, k in turns]
# letters by order of first appearance: A = first person to talk
order = {k: i for i, k in enumerate(dict.fromkeys(k for _, _, k in turns))}
turns = [(s, e, order[k]) for s, e, k in turns]


def speaker(start, end):
    """Speaker covering most of this transcript row.

    Overlapping speech: the main speaker's long turn and a short interjection can both cover the
    row fully, so among speakers covering ~as much as the best, the shorter (more specific) turn wins.
    """
    cover, shortest = {}, {}
    for s, e, spk in turns:
        o = max(0, min(end, e) - max(start, s))
        if o:
            cover[spk] = cover.get(spk, 0) + o
            shortest[spk] = min(shortest.get(spk, e - s), e - s)
    if not cover:
        return "?"
    top = max(cover.values())
    return chr(65 + min((k for k in cover if cover[k] >= 0.9 * top), key=shortest.get))


out = [["start", "end", "text", "speaker"]]
js = tsv.with_suffix(".json")
if js.exists():
    # label each word (needs --word_timestamps) and split a segment wherever the speaker changes
    for seg in json.loads(js.read_text())["segments"]:
        words = seg.get("words") or [{"start": seg["start"], "end": seg["end"], "word": seg["text"]}]
        spans = [(int(w["start"] * 1000), int(w["end"] * 1000)) for w in words]
        labels = [speaker(s, e) for s, e in spans]
        runs = [[labels[0], 0, 1]]  # [speaker, first word, end word]
        for j, spk in enumerate(labels[1:], 1):
            if spk == runs[-1][0] or spk == "?":  # "?" = word in a gap between turns: keep current speaker
                runs[-1][2] = j + 1
            else:
                runs.append([spk, j, j + 1])
        # turn boundaries are only ~0.3 s accurate: a 1-2 word run inside a segment joins its neighbour
        for k, r in enumerate(runs):
            if len(runs) > 1 and r[2] - r[1] <= 2:
                r[0] = runs[k - 1][0] if k else runs[1][0]
        for spk, a, b in runs:
            if out[-1][3] == spk and out[-1][4] is seg:
                out[-1][1], out[-1][2] = spans[b - 1][1], out[-1][2] + "".join(w["word"] for w in words[a:b])
            else:
                out.append([spans[a][0], spans[b - 1][1], "".join(w["word"] for w in words[a:b]), spk, seg])
    out = [[str(c).strip() for c in r[:4]] for r in out]
else:
    for r in tsv.read_text().splitlines()[1:]:
        c = r.split("\t")[:3]
        out.append(c + [speaker(int(c[0]), int(c[1]))])
tsv.write_text("\n".join("\t".join(c) for c in out) + "\n")
print(f"{tsv}: {len({t[2] for t in turns})} speakers")
